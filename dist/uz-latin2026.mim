(input-method uz latin2026)
(description "Uzbek Latin 2026: ss->ş cc->ç gg->ğ oo->ö, sss->ss")
(title "UZ")
(map
 (trans
  ("ss" ?ş)
  ("sss" "ss")
  ("SS" ?Ş)
  ("Ss" ?Ş)
  ("SSS" "SS")
  ("Sss" "Ss")
  ("cc" ?ç)
  ("ccc" "cc")
  ("CC" ?Ç)
  ("Cc" ?Ç)
  ("CCC" "CC")
  ("Ccc" "Cc")
  ("gg" ?ğ)
  ("ggg" "gg")
  ("GG" ?Ğ)
  ("Gg" ?Ğ)
  ("GGG" "GG")
  ("Ggg" "Gg")
  ("oo" ?ö)
  ("ooo" "oo")
  ("OO" ?Ö)
  ("Oo" ?Ö)
  ("OOO" "OO")
  ("Ooo" "Oo")))
(state
 (init
  (trans)))
